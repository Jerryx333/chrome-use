    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan the pairing QR code shown in the computer’s terminal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描电脑终端上显示的配对二维码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掃描電腦終端機上顯示的配對 QR 碼。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンピュータのターミナルに表示されるペアリング用 QR コードをスキャンします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컴퓨터 터미널에 표시된 페어링 QR 코드를 스캔합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanea el código QR de emparejamiento que aparece en el terminal del ordenador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanner le code QR de jumelage affiché dans le terminal de l’ordinateur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanne den Kopplungs-QR-Code, der im Terminal deines Computers angezeigt wird."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escaneie o código QR de emparelhamento exibido no terminal do computador."
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock chrome-use with Face ID."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用面容 ID 解锁 chrome-use。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Face ID 解鎖 chrome-use。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID で chrome-use のロックを解除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID로 chrome-use의 잠금을 해제합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquea chrome-use con Face ID."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déverrouiller chrome-use avec Face ID."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "chrome-use mit Face ID entsperren."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueie o chrome-use com Face ID."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to your computer running chrome-use on your local network or Tailscale."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接你在同一局域网或 Tailscale 里运行 chrome-use 的电脑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線到你在區域網路或 Tailscale 中執行 chrome-use 的電腦。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルネットワークまたは Tailscale 上で chrome-use を実行しているコンピュータに接続します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 네트워크 또는 Tailscale에서 chrome-use를 실행 중인 컴퓨터에 연결합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conéctate al ordenador que ejecuta chrome-use en tu red local o en Tailscale."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se connecter à l’ordinateur qui exécute chrome-use sur votre réseau local ou Tailscale."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit deinem Computer verbinden, auf dem chrome-use im lokalen Netzwerk oder über Tailscale läuft."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte-se ao computador que executa o chrome-use na sua rede local ou no Tailscale."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose images to send to the agent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择要发给 agent 的图片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇要傳送給 agent 的圖片。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントに送信する画像を選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트에게 보낼 이미지를 선택합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige imágenes para enviarlas al agente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisir des images à envoyer à l’agent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle Bilder aus, die an den Agent gesendet werden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha imagens para enviar ao agente."
          }
        }
      }
    }
  },
  "version": "1.0"
}
