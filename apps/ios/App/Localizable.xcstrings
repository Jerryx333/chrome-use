    "Tap the button at the top right to start one.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the button at the top right to start one."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点右上角新建一个对话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下右上角的按鈕來新增對話。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右上のボタンをタップして会話を開始します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오른쪽 상단의 버튼을 탭하여 시작하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el botón de arriba a la derecha para empezar una."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez le bouton en haut à droite pour en lancer une."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe oben rechts auf die Taste, um eine zu starten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no botão no canto superior direito para iniciar uma."
          }
        }
      }
    },
    "The computer did not answer in time.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The computer did not answer in time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电脑没有及时回应。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "電腦未及時回應。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンピュータから時間内に応答がありませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컴퓨터가 제시간에 응답하지 않았습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ordenador no respondió a tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ordinateur n’a pas répondu à temps."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Computer hat nicht rechtzeitig geantwortet."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O computador não respondeu a tempo."
          }
        }
      }
    },
    "The computer does not recognize this phone: the pairing may have been revoked, disabled or expired. Pair again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The computer does not recognize this phone: the pairing may have been revoked, disabled or expired. Pair again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电脑不认识这部手机：配对可能已被撤销、禁用或已过期。请重新配对。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "電腦無法辨識這支手機：配對可能已被撤銷、停用或已過期。請重新配對。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンピュータがこの iPhone を認識できません。ペアリングが取り消された、無効にされた、または期限切れになった可能性があります。もう一度ペアリングしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컴퓨터가 이 휴대폰을 인식하지 못합니다. 페어링이 취소, 비활성화 또는 만료되었을 수 있습니다. 다시 페어링하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ordenador no reconoce este teléfono: puede que el emparejamiento se haya revocado, desactivado o caducado. Vuelve a emparejarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ordinateur ne reconnaît pas ce téléphone : le jumelage a peut-être été révoqué, désactivé ou a expiré. Jumelez-le à nouveau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Computer erkennt dieses iPhone nicht: Die Kopplung wurde möglicherweise widerrufen, deaktiviert oder ist abgelaufen. Kopple erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O computador não reconhece este iPhone: o emparelhamento pode ter sido revogado, desativado ou expirado. Emparelhe novamente."
          }
        }
      }
    },
    "The computer refused this QR code: it may have been used, expired (10 minutes) or revoked. Run mobile pair again on the computer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The computer refused this QR code: it may have been used, expired (10 minutes) or revoked. Run mobile pair again on the computer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电脑拒绝了这个二维码：它可能已被使用、已过期（10 分钟）或已被撤销。请在电脑上重新运行 mobile pair。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "電腦拒絕了這個 QR 碼：它可能已被使用、已過期（10 分鐘）或已被撤銷。請在電腦上重新執行 mobile pair。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンピュータがこの QR コードを拒否しました。使用済み、期限切れ（10分）、または取り消された可能性があります。コンピュータで mobile pair をもう一度実行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컴퓨터가 이 QR 코드를 거부했습니다. 이미 사용되었거나 만료(10분)되었거나 취소되었을 수 있습니다. 컴퓨터에서 mobile pair를 다시 실행하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ordenador rechazó este código QR: puede que ya se haya usado, haya caducado (10 minutos) o se haya revocado. Vuelve a ejecutar mobile pair en el ordenador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ordinateur a refusé ce code QR : il a peut-être déjà été utilisé, a expiré (10 minutes) ou a été révoqué. Relancez mobile pair sur l’ordinateur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Computer hat diesen QR-Code abgelehnt: Er wurde möglicherweise bereits verwendet, ist abgelaufen (10 Minuten) oder wurde widerrufen. Führe mobile pair erneut auf dem Computer aus."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O computador recusou este código QR: ele pode já ter sido usado, expirado (10 minutos) ou sido revogado. Execute mobile pair novamente no computador."
          }
        }
      }
    },
    "The computer rejected a message; the connection was reset and is reconnecting.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The computer rejected a message; the connection was reset and is reconnecting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电脑拒绝了一条数据，连接已重置，正在重连。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "電腦拒絕了一則訊息，連線已重置，正在重新連線。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンピュータがメッセージを拒否しました。接続をリセットし、再接続しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컴퓨터가 메시지를 거부하여 연결을 재설정하고 다시 연결하는 중입니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ordenador rechazó un mensaje; la conexión se ha restablecido y se está reconectando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ordinateur a rejeté un message ; la connexion a été réinitialisée et se rétablit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Computer hat eine Nachricht abgelehnt; die Verbindung wurde zurückgesetzt und wird neu aufgebaut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O computador rejeitou uma mensagem; a conexão foi redefinida e está sendo restabelecida."
          }
        }
      }
    },
    "The conversation will be deleted from the computer. This cannot be undone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The conversation will be deleted from the computer. This cannot be undone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对话会从电脑上删除，无法恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對話將從電腦上刪除，此動作無法復原。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会話をコンピュータから削除します。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대화가 컴퓨터에서 삭제됩니다. 이 작업은 실행 취소할 수 없습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conversación se eliminará del ordenador. No se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La conversation sera supprimée de l’ordinateur. Cette action est irréversible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Konversation wird vom Computer gelöscht. Dies kann nicht widerrufen werden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conversa será apagada do computador. Não é possível desfazer."
          }
        }
      }
    },
    "The image is still larger than 512 KiB after compression.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The image is still larger than 512 KiB after compression."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片太大，压缩后仍超过 512 KiB。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖片壓縮後仍超過 512 KiB。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "圧縮後も画像が 512 KiB を超えています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "압축 후에도 이미지가 512KiB보다 큽니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
