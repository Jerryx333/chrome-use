          "stringUnit": {
            "state": "translated",
            "value": "Public addresses need wss://. ws:// is only for Tailscale or local network addresses."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "公网地址必须用 wss://。ws:// 只能用于 Tailscale 或局域网地址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "公開位址必須使用 wss://。ws:// 只能用於 Tailscale 或區域網路位址。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パブリックアドレスには wss:// が必要です。ws:// は Tailscale またはローカルネットワークのアドレスでのみ使用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공개 주소에는 wss://가 필요합니다. ws://는 Tailscale 또는 로컬 네트워크 주소에만 사용할 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
