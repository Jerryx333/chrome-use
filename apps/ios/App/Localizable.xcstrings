    "已解锁": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlocked"
          }
        }
      }
    },
    "已解锁，感谢支持。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlocked. Thanks for your support."
          }
        }
      }
    },
    "已请求停止：只能拒绝，不能再允许。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop was requested: you can only decline now."
