    "Cannot reach the computer. Make sure chrome-use mobile serve is running and the phone can reach its address.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot reach the computer. Make sure chrome-use mobile serve is running and the phone can reach its address."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接到电脑。请确认 chrome-use mobile serve 正在运行，且手机能访问该地址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連線到電腦。請確認 chrome-use mobile serve 正在執行，且手機能連到該位址。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンピュータに接続できません。chrome-use mobile serve が実行中で、iPhone からそのアドレスに接続できることを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컴퓨터에 연결할 수 없습니다. chrome-use mobile serve가 실행 중이고 휴대폰에서 해당 주소에 접근할 수 있는지 확인하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede conectar con el ordenador. Asegúrate de que chrome-use mobile serve está en ejecución y de que el teléfono puede acceder a su dirección."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre l’ordinateur. Vérifiez que chrome-use mobile serve est en cours d’exécution et que le téléphone peut accéder à son adresse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Computer nicht erreichbar. Stelle sicher, dass chrome-use mobile serve läuft und das iPhone die Adresse erreichen kann."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível acessar o computador. Verifique se chrome-use mobile serve está em execução e se o celular consegue acessar o endereço."
          }
        }
      }
    },
