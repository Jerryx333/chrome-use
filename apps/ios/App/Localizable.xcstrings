    "Your trial has ended. Reading, stopping and declining stay free; sending, starting conversations and allowing requests need the unlock.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your trial has ended. Reading, stopping and declining stay free; sending, starting conversations and allowing requests need the unlock."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "试用已结束。查看对话、停止任务和拒绝请求仍然免费；发送、新建和允许请求需要解锁。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "試用已結束。檢視對話、停止任務和拒絕請求仍然免費；傳送訊息、新增對話和允許請求則需要解鎖。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トライアルが終了しました。閲覧、停止、拒否は引き続き無料です。送信、会話の開始、リクエストの許可にはロック解除が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체험 기간이 종료되었습니다. 대화 보기, 중단, 거부는 계속 무료이며, 메시지 보내기, 새 대화 시작, 요청 허용에는 잠금 해제가 필요합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu prueba ha terminado. Leer, detener y denegar sigue siendo gratis; para enviar, iniciar conversaciones y permitir solicitudes tienes que desbloquear la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre essai est terminé. Lire, arrêter et refuser restent gratuits ; envoyer, lancer des conversations et autoriser des demandes nécessitent le déverrouillage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Testzeitraum ist abgelaufen. Lesen, Stoppen und Ablehnen bleiben kostenlos; Senden, neue Konversationen und das Erlauben von Anfragen erfordern die Freischaltung."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu teste terminou. Ler, parar e recusar continuam gratuitos; enviar, iniciar conversas e permitir solicitações exigem o desbloqueio."
          }
        }
      }
    },
