      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New conversation"
          }
        }
      }
    },
    "无法截图：这个对话的浏览器会话没有在运行。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot take a screenshot: this conversation’s browser session is not running."
          }
        }
      }
    },
    "无法显示截图": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
