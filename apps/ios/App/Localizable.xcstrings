          }
        }
      }
    },
    "无法载入商品：%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot load products: %@"
          }
        }
      }
    },
    "无法迁移已配对的电脑：%@": {
      "localizations": {
        "en": {
