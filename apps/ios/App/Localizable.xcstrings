    "Notifications are end-to-end encrypted on the computer; the push service only forwards ciphertext it cannot read.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are end-to-end encrypted on the computer; the push service only forwards ciphertext it cannot read."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "推送内容在电脑上端到端加密，推送服务只转发看不懂的密文。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通知內容會在電腦上進行端對端加密，推播服務只轉送它無法讀取的密文。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知はコンピュータ上でエンドツーエンド暗号化されます。プッシュサービスは、内容を読めない暗号文を転送するだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림은 컴퓨터에서 종단 간 암호화되며, 푸시 서비스는 읽을 수 없는 암호문만 전달합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones se cifran de extremo a extremo en el ordenador; el servicio push solo reenvía texto cifrado que no puede leer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sont chiffrées de bout en bout sur l’ordinateur ; le service push ne transmet qu’un contenu chiffré qu’il ne peut pas lire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen werden auf dem Computer Ende-zu-Ende-verschlüsselt; der Push-Dienst leitet nur Chiffretext weiter, den er nicht lesen kann."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações são criptografadas de ponta a ponta no computador; o serviço de push apenas repassa um texto cifrado que não consegue ler."
          }
        }
      }
    },
    "Now": {
      "localizations": {
        "en": {
          "stringUnit": {
