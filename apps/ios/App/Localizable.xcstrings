            "state": "translated",
            "value": "無法驗證購買項目：%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入を確認できませんでした：%@"
          }
        }
      }
    },
    "The purchase is waiting for approval.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The purchase is waiting for approval."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "购买等待批准。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "購買項目正在等待核准。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入は承認待ちです。"
          }
        }
      }
    },
    "The push token was refused (%@); registering again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The push token was refused (%@); registering again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "推送令牌被拒绝（%@），正在重新注册。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "推播權杖遭拒（%@），正在重新註冊。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プッシュトークンが拒否されました（%@）。再登録しています。"
          }
        }
      }
    },
    "This computer allows high-access conversations from the phone": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This computer allows high-access conversations from the phone"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此电脑允许手机操作高权限对话"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台電腦允許從手機操作高權限對話"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコンピュータは iPhone からの高い権限の会話を許可しています"
          }
        }
      }
    },
    "This conversation was deleted on the computer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This conversation was deleted on the computer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个对话已在电脑上删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個對話已在電腦上刪除。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この会話はコンピュータで削除されました。"
          }
        }
      }
    },
    "This conversation’s access is too high. Run `chrome-use mobile access %@ full` on the computer to drive it from the phone": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This conversation’s access is too high. Run `chrome-use mobile access %@ full` on the computer to drive it from the phone"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个对话权限太高，需要在电脑上运行 `chrome-use mobile access %@ full` 才能从手机操作"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個對話的權限太高。請在電腦上執行 `chrome-use mobile access %@ full`，才能從手機操作"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この会話は権限が高すぎます。iPhone から操作するには、コンピュータで `chrome-use mobile access %@ full` を実行してください"
          }
        }
      }
    },
    "This is not a chrome-use pairing link.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is not a chrome-use pairing link."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这不是 chrome-use 配对链接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這不是 chrome-use 配對連結。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは chrome-use のペアリングリンクではありません。"
          }
        }
      }
    },
    "This pairing link version is not supported; update the app.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This pairing link version is not supported; update the app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对链接版本不受支持，请更新 App。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不支援此配對連結版本，請更新 App。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このペアリングリンクのバージョンはサポートされていません。App をアップデートしてください。"
          }
        }
      }
    },
    "This phone has no passcode, so it cannot drive high-access conversations. Set a passcode in Settings first.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone has no passcode, so it cannot drive high-access conversations. Set a passcode in Settings first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台手机没有设置锁屏密码，不能操作高权限对话。请先在系统设置里设置密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這支手機沒有設定鎖定密碼，不能操作高權限對話。請先在系統設定裡設定密碼。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPhoneにはパスコードが設定されていないため、高権限の会話は操作できません。先に設定でパスコードを設定してください。"
          }
        }
      }
    },
    "This phone is paired to another browser profile than the running gateway serves. Start mobile serve with the matching --profile on the computer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone is paired to another browser profile than the running gateway serves. Start mobile serve with the matching --profile on the computer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这部手机配对的是另一个浏览器配置，当前运行的网关不服务它。请在电脑上用对应的 --profile 启动 mobile serve。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這支手機配對的瀏覽器設定檔與目前執行中的閘道不同。請在電腦上以對應的 --profile 啟動 mobile serve。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この iPhone は、実行中のゲートウェイとは別のブラウザプロファイルとペアリングされています。コンピュータで対応する --profile を指定して mobile serve を起動してください。"
          }
        }
      }
    },
    "This phone was revoked on the computer. Pair again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone was revoked on the computer. Pair again."
