        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "chrome-use 페어링 링크가 아닙니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este no es un enlace de emparejamiento de chrome-use."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce n’est pas un lien de jumelage chrome-use."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist kein chrome-use-Kopplungslink."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este não é um link de emparelhamento do chrome-use."
          }
        }
      }
    },
    "This pairing link version is not supported; update the app.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This pairing link version is not supported; update the app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对链接版本不受支持，请更新 App。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不支援此配對連結版本，請更新 App。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このペアリングリンクのバージョンはサポートされていません。App をアップデートしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지원되지 않는 페어링 링크 버전입니다. 앱을 업데이트하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versión del enlace de emparejamiento no es compatible; actualiza la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version de lien de jumelage n’est pas prise en charge ; mettez à jour l’app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Version des Kopplungslinks wird nicht unterstützt; aktualisiere die App."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versão de link de emparelhamento não é compatível; atualize o app."
          }
        }
      }
    },
    "This phone is paired to another browser profile than the running gateway serves. Start mobile serve with the matching --profile on the computer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone is paired to another browser profile than the running gateway serves. Start mobile serve with the matching --profile on the computer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这部手机配对的是另一个浏览器配置，当前运行的网关不服务它。请在电脑上用对应的 --profile 启动 mobile serve。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這支手機配對的瀏覽器設定檔與目前執行中的閘道不同。請在電腦上以對應的 --profile 啟動 mobile serve。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この iPhone は、実行中のゲートウェイとは別のブラウザプロファイルとペアリングされています。コンピュータで対応する --profile を指定して mobile serve を起動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 휴대폰은 실행 중인 게이트웨이와 다른 브라우저 프로필에 페어링되어 있습니다. 컴퓨터에서 일치하는 --profile로 mobile serve를 시작하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este teléfono está emparejado con un perfil del navegador distinto del que sirve la pasarela en ejecución. Inicia mobile serve con el --profile correspondiente en el ordenador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce téléphone est jumelé à un autre profil de navigateur que celui servi par la passerelle active. Lancez mobile serve avec le --profile correspondant sur l’ordinateur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses iPhone ist mit einem anderen Browserprofil gekoppelt als dem, das das laufende Gateway bedient. Starte mobile serve auf dem Computer mit dem passenden --profile."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este iPhone está emparelhado com um perfil de navegador diferente do atendido pelo gateway em execução. Inicie mobile serve com o --profile correspondente no computador."
          }
        }
      }
    },
    "This phone was revoked on the computer. Pair again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone was revoked on the computer. Pair again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这部手机已在电脑上被撤销，请重新配对。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這支手機已在電腦上被撤銷，請重新配對。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この iPhone はコンピュータで取り消されました。もう一度ペアリングしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컴퓨터에서 이 휴대폰의 페어링이 취소되었습니다. 다시 페어링하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este teléfono se revocó en el ordenador. Vuelve a emparejarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce téléphone a été révoqué sur l’ordinateur. Jumelez-le à nouveau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses iPhone wurde auf dem Computer widerrufen. Kopple erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este iPhone foi revogado no computador. Emparelhe novamente."
          }
        }
      }
    },
    "This replaces “%@”: a different address or computer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This replaces “%@”: a different address or computer"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会替换「%@」，地址/电脑不同"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會取代「%@」：位址或電腦不同"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」を置き換えます：アドレスまたはコンピュータが異なります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’을(를) 교체합니다. 주소 또는 컴퓨터가 다릅니다"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto reemplaza “%@”: es otra dirección u otro ordenador"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci remplace « %@ » : adresse ou ordinateur différent"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ersetzt „%@“: andere Adresse oder anderer Computer"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto substitui “%@”: outro endereço ou computador"
          }
        }
      }
    },
    "This request (%@) can only be answered on the computer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This request (%@) can only be answered on the computer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个请求（%@）只能在电脑上处理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個請求（%@）只能在電腦上處理。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリクエスト（%@）にはコンピュータでのみ対応できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 요청(%@)은 컴퓨터에서만 응답할 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta solicitud (%@) solo se puede responder en el ordenador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette demande (%@) ne peut être traitée que sur l’ordinateur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Anfrage (%@) kann nur auf dem Computer beantwortet werden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta solicitação (%@) só pode ser respondida no computador."
          }
        }
      }
    },
    "This request is too long to show in full on the phone. Answer it on the computer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This request is too long to show in full on the phone. Answer it on the computer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求内容太长，手机上只显示了一部分。请在电脑上处理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個請求內容太長，手機上無法完整顯示。請在電腦上處理。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリクエストは長すぎるため、iPhone ではすべてを表示できません。コンピュータで対応してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청 내용이 너무 길어 휴대폰에서 모두 표시할 수 없습니다. 컴퓨터에서 응답하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta solicitud es demasiado larga para mostrarla entera en el teléfono. Respóndela en el ordenador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette demande est trop longue pour s’afficher en entier sur le téléphone. Répondez-y sur l’ordinateur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Anfrage ist zu lang, um sie vollständig auf dem iPhone anzuzeigen. Beantworte sie auf dem Computer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta solicitação é longa demais para ser exibida inteira no celular. Responda no computador."
          }
        }
      }
    },
    "Too many failed attempts; the computer asks to try again later.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many failed attempts; the computer asks to try again later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "失败次数过多，电脑要求稍后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "失敗次數過多，電腦要求稍後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "失敗した回数が多すぎます。しばらくしてからもう一度試してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실패 횟수가 너무 많습니다. 컴퓨터에서 나중에 다시 시도하도록 요청했습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiados intentos fallidos; el ordenador pide volver a intentarlo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de tentatives échouées ; l’ordinateur demande de réessayer plus tard."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele Fehlversuche; der Computer bittet, es später erneut zu versuchen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Muitas tentativas sem sucesso; o computador pede que você tente mais tarde."
          }
        }
      }
    },
    "Too many requests; try again shortly.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many requests; try again shortly."
          }
        },
        "zh-Hans": {
