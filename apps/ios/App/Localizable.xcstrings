    "On the computer, run chrome-use mobile pair --url <address your phone can reach> and scan the QR code in the terminal.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the computer, run chrome-use mobile pair --url <address your phone can reach> and scan the QR code in the terminal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在电脑上运行 chrome-use mobile pair --url <手机能访问的地址>，扫描终端里的二维码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在電腦上執行 chrome-use mobile pair --url <手機能連到的位址>，然後掃描終端機中的 QR 碼。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンピュータで chrome-use mobile pair --url <iPhone から接続できるアドレス> を実行し、ターミナルに表示される QR コードをスキャンしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컴퓨터에서 chrome-use mobile pair --url <휴대폰에서 접근 가능한 주소>를 실행하고 터미널에 표시된 QR 코드를 스캔하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el ordenador, ejecuta chrome-use mobile pair --url <dirección accesible desde tu teléfono> y escanea el código QR del terminal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur l’ordinateur, exécutez chrome-use mobile pair --url <adresse accessible depuis votre téléphone> et scannez le code QR affiché dans le terminal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führe auf dem Computer chrome-use mobile pair --url <für dein iPhone erreichbare Adresse> aus und scanne den QR-Code im Terminal."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No computador, execute chrome-use mobile pair --url <endereço que o celular consegue acessar> e escaneie o código QR no terminal."
          }
        }
      }
    },
    "On the computer, run chrome-use mobile serve, then chrome-use mobile pair --url <address> to show a QR code, and scan it here.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the computer, run chrome-use mobile serve, then chrome-use mobile pair --url <address> to show a QR code, and scan it here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在电脑上运行 chrome-use mobile serve，再用 chrome-use mobile pair --url <地址> 显示二维码，然后在这里扫码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在電腦上執行 chrome-use mobile serve，再用 chrome-use mobile pair --url <位址> 顯示 QR 碼，然後在這裡掃描。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンピュータで chrome-use mobile serve を実行し、次に chrome-use mobile pair --url <アドレス> で QR コードを表示して、ここでスキャンしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컴퓨터에서 chrome-use mobile serve를 실행한 다음 chrome-use mobile pair --url <주소>로 QR 코드를 표시하고 여기에서 스캔하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el ordenador, ejecuta chrome-use mobile serve y luego chrome-use mobile pair --url <dirección> para mostrar un código QR, y escanéalo aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur l’ordinateur, exécutez chrome-use mobile serve, puis chrome-use mobile pair --url <adresse> pour afficher un code QR, et scannez-le ici."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führe auf dem Computer chrome-use mobile serve aus, zeige dann mit chrome-use mobile pair --url <Adresse> einen QR-Code an und scanne ihn hier."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No computador, execute chrome-use mobile serve e depois chrome-use mobile pair --url <endereço> para exibir um código QR; escaneie-o aqui."
          }
        }
      }
    },
    "Only change this if you run your own push Worker.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only change this if you run your own push Worker."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自建推送 Worker 时才需要修改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在自架推播 Worker 時才需要修改。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "独自のプッシュ用 Worker を運用している場合のみ変更してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자체 푸시 Worker를 운영하는 경우에만 변경하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cámbialo solo si usas tu propio Worker de notificaciones push."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À modifier uniquement si vous hébergez votre propre Worker push."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur ändern, wenn du einen eigenen Push-Worker betreibst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Altere apenas se você tiver seu próprio Worker de push."
          }
        }
      }
    },
