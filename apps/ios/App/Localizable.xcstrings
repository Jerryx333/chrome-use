    "This computer allows high-access conversations from the phone": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This computer allows high-access conversations from the phone"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此电脑允许手机操作高权限对话"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台電腦允許從手機操作高權限對話"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコンピュータは iPhone からの高い権限の会話を許可しています"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 컴퓨터는 휴대폰에서 높은 권한의 대화를 허용합니다"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este ordenador permite controlar conversaciones con acceso elevado desde el teléfono"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet ordinateur autorise les conversations à accès élevé depuis le téléphone"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Computer erlaubt Konversationen mit erweitertem Zugriff vom iPhone"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este computador permite conversas com acesso elevado pelo iPhone"
          }
        }
      }
    },
    "This conversation was deleted on the computer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This conversation was deleted on the computer."
          }
        },
        "zh-Hans": {
