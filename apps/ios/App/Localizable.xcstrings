    "A computer lets this phone drive high-access conversations, so the lock is required: at launch and after more than 5 minutes away.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A computer lets this phone drive high-access conversations, so the lock is required: at launch and after more than 5 minutes away."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有电脑允许手机操作高权限对话，所以必须开启：启动时和离开超过 5 分钟后都要验证。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有電腦允許這支手機操作高權限對話，因此必須開啟鎖定：啟動時及離開超過 5 分鐘後都需要驗證。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高い権限の会話を iPhone から操作できるコンピュータがあるため、ロックは必須です。起動時と、5分以上離れた後に認証が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대폰에서 높은 권한의 대화를 조작하도록 허용한 컴퓨터가 있어 잠금이 필요합니다. 앱을 실행할 때와 5분 이상 자리를 비운 후에 인증합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ordenador permite a este teléfono controlar conversaciones con acceso elevado, así que el bloqueo es obligatorio: al abrir la app y tras más de 5 minutos fuera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ordinateur autorise ce téléphone à piloter des conversations à accès élevé ; le verrouillage est donc obligatoire, au lancement et après plus de 5 minutes d’absence."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Computer erlaubt diesem iPhone Konversationen mit erweitertem Zugriff, daher ist die Sperre erforderlich: beim Start und nach mehr als 5 Minuten Abwesenheit."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um computador permite que este iPhone controle conversas com acesso elevado, por isso o bloqueio é obrigatório: ao abrir o app e após mais de 5 minutos fora dele."
          }
        }
      }
    },
