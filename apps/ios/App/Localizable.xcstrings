    "chrome-use Remote drives the agent panel on your computer from your phone; the agent and your signed-in Chrome stay on the computer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "chrome-use Remote drives the agent panel on your computer from your phone; the agent and your signed-in Chrome stay on the computer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "chrome-use 遥控让你在手机上操作电脑上的 agent 面板；agent 和登录的 Chrome 都留在电脑上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "chrome-use Remote 讓你用手機操作電腦上的 agent 面板；agent 和已登入的 Chrome 都留在電腦上。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "chrome-use Remote を使うと、コンピュータのエージェントパネルを iPhone から操作できます。エージェントとサインイン済みの Chrome はコンピュータ上で動作し続けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "chrome-use Remote로 휴대폰에서 컴퓨터의 에이전트 패널을 조작할 수 있습니다. 에이전트와 로그인된 Chrome은 컴퓨터에 그대로 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "chrome-use Remote controla desde el teléfono el panel del agente de tu ordenador; el agente y tu Chrome con sesión iniciada se quedan en el ordenador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "chrome-use Remote pilote depuis votre téléphone le panneau d’agent de votre ordinateur ; l’agent et votre Chrome connecté restent sur l’ordinateur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit chrome-use Remote steuerst du das Agent-Panel auf deinem Computer vom iPhone aus; der Agent und dein angemeldetes Chrome bleiben auf dem Computer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O chrome-use Remote controla pelo celular o painel do agente no seu computador; o agente e o Chrome com sua sessão iniciada continuam no computador."
          }
        }
      }
    },
