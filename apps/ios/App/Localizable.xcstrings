    "OpenCode always runs commands, so it can only be started on the computer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenCode always runs commands, so it can only be started on the computer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenCode 总是可以运行命令，只能在电脑上新建。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenCode 一律可以執行指令，因此只能在電腦上新增。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenCode は常にコマンドを実行するため、コンピュータでのみ開始できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenCode는 항상 명령을 실행하므로 컴퓨터에서만 시작할 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenCode siempre ejecuta comandos, así que solo se puede iniciar en el ordenador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenCode exécute toujours des commandes ; il ne peut donc être lancé que sur l’ordinateur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenCode führt immer Befehle aus und kann daher nur am Computer gestartet werden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O OpenCode sempre executa comandos, por isso só pode ser iniciado no computador."
          }
        }
      }
    },
