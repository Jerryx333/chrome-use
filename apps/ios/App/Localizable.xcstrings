      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Muted"
          }
        }
      }
    },
    "开启后，每次回到 App 都需要验证。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on, you authenticate every time you return to the app."
