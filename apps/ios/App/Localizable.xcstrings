      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start"
          }
        }
      }
    },
    "开始 14 天免费试用": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start 14-day free trial"
          }
        }
      }
    },
    "恢复购买": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore purchases"
          }
        }
      }
