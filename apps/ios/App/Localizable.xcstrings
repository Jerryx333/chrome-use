    "Notifications are end-to-end encrypted on the computer; the push service only forwards ciphertext it cannot read.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are end-to-end encrypted on the computer; the push service only forwards ciphertext it cannot read."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "推送内容在电脑上端到端加密，推送服务只转发看不懂的密文。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通知內容會在電腦上進行端對端加密，推播服務只轉送它無法讀取的密文。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知はコンピュータ上でエンドツーエンド暗号化されます。プッシュサービスは、内容を読めない暗号文を転送するだけです。"
          }
        }
      }
    },
