    "允许一次": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow once"
          }
        }
      }
    },
    "允许通知": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow notifications"
          }
        }
      }
    },
    "先免费试用 14 天，或直接一次性解锁。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try it free for 14 days, or unlock once."
          }
        }
      }
    },
    "公网地址必须用 wss://。ws:// 只能用于 Tailscale 或局域网地址。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Public addresses need wss://. ws:// is only for Tailscale or local network addresses."
          }
        }
      }
    },
    "关于": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About"
          }
        }
      }
    },
    "关闭": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        }
      }
    },
    "其他…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Other…"
          }
        }
      }
    },
    "删除": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete"
          }
        }
      }
    },
    "删除对话": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete conversation"
          }
        }
      }
    },
