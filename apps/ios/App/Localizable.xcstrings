    "停止中": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopping"
          }
        }
      }
    },
    "停止任务、截图、运行定时任务": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop turns, take screenshots, run schedules"
