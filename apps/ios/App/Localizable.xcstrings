        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先免費試用 14 天，或直接一次性解鎖。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "14日間無料で試すか、一度の購入でロックを解除できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "14일 동안 무료로 사용해 보거나 한 번에 잠금 해제하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pruébalo gratis 14 días o desbloquéalo con un único pago."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez gratuitement pendant 14 jours, ou déverrouillez en une fois."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teste 14 Tage kostenlos oder schalte einmalig frei."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimente grátis por 14 dias ou desbloqueie de uma vez."
          }
        }
      }
    },
