    "Conversations started from the phone can at most write files; when the agent needs to run a command it asks you to approve.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversations started from the phone can at most write files; when the agent needs to run a command it asks you to approve."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手机上新建的对话最多“可写文件”；需要运行命令时 agent 会请你审批。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從手機新增的對話最多只能「寫入檔案」；agent 需要執行指令時會請你核准。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone から開始した会話で許可されるのはファイルの書き込みまでです。エージェントがコマンドを実行する必要があるときは、承認を求めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대폰에서 시작한 대화는 최대 ‘파일 쓰기’ 권한까지만 가집니다. 에이전트가 명령을 실행해야 하면 승인을 요청합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las conversaciones iniciadas desde el teléfono como mucho pueden escribir archivos; cuando el agente necesita ejecutar un comando, te pide aprobación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les conversations lancées depuis le téléphone peuvent au plus écrire des fichiers ; quand l’agent doit exécuter une commande, il vous demande votre accord."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vom iPhone gestartete Konversationen dürfen höchstens Dateien schreiben; muss der Agent einen Befehl ausführen, bittet er dich um Zustimmung."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversas iniciadas pelo celular podem no máximo gravar arquivos; quando o agente precisar executar um comando, ele pedirá sua aprovação."
          }
        }
      }
    },
