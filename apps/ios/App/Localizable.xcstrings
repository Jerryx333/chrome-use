          "stringUnit": {
            "state": "translated",
            "value": "這個對話已在電腦上刪除。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この会話はコンピュータで削除されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 대화는 컴퓨터에서 삭제되었습니다."
          }
        },
        "es": {
