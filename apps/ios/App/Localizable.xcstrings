    "This conversation’s access is too high. Run `chrome-use mobile access %@ full` on the computer to drive it from the phone": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This conversation’s access is too high. Run `chrome-use mobile access %@ full` on the computer to drive it from the phone"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个对话权限太高，需要在电脑上运行 `chrome-use mobile access %@ full` 才能从手机操作"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個對話的權限太高。請在電腦上執行 `chrome-use mobile access %@ full`，才能從手機操作"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この会話は権限が高すぎます。iPhone から操作するには、コンピュータで `chrome-use mobile access %@ full` を実行してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 대화는 권한이 너무 높습니다. 휴대폰에서 조작하려면 컴퓨터에서 `chrome-use mobile access %@ full`을 실행하세요"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso de esta conversación es demasiado elevado. Ejecuta `chrome-use mobile access %@ full` en el ordenador para controlarla desde el teléfono"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès de cette conversation est trop élevé. Exécutez `chrome-use mobile access %@ full` sur l’ordinateur pour la piloter depuis le téléphone"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Konversation hat zu weitreichenden Zugriff. Führe `chrome-use mobile access %@ full` auf dem Computer aus, um sie vom iPhone zu steuern"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso desta conversa é alto demais. Execute `chrome-use mobile access %@ full` no computador para controlá-la pelo iPhone"
          }
        }
      }
    },
    "This is not a chrome-use pairing link.": {
