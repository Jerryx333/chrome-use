    },
    "The computer did not answer in time.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The computer did not answer in time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电脑没有及时回应。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "電腦未及時回應。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンピュータから時間内に応答がありませんでした。"
          }
        }
      }
    },
    "The computer does not recognize this phone: the pairing may have been revoked, disabled or expired. Pair again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The computer does not recognize this phone: the pairing may have been revoked, disabled or expired. Pair again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电脑不认识这部手机：配对可能已被撤销、禁用或已过期。请重新配对。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "電腦無法辨識這支手機：配對可能已被撤銷、停用或已過期。請重新配對。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンピュータがこの iPhone を認識できません。ペアリングが取り消された、無効にされた、または期限切れになった可能性があります。もう一度ペアリングしてください。"
          }
        }
      }
    },
    "The computer refused this QR code: it may have been used, expired (10 minutes) or revoked. Run mobile pair again on the computer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The computer refused this QR code: it may have been used, expired (10 minutes) or revoked. Run mobile pair again on the computer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电脑拒绝了这个二维码：它可能已被使用、已过期（10 分钟）或已被撤销。请在电脑上重新运行 mobile pair。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "電腦拒絕了這個 QR 碼：它可能已被使用、已過期（10 分鐘）或已被撤銷。請在電腦上重新執行 mobile pair。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンピュータがこの QR コードを拒否しました。使用済み、期限切れ（10分）、または取り消された可能性があります。コンピュータで mobile pair をもう一度実行してください。"
          }
        }
      }
    },
    "The computer rejected a message; the connection was reset and is reconnecting.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The computer rejected a message; the connection was reset and is reconnecting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电脑拒绝了一条数据，连接已重置，正在重连。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "電腦拒絕了一則訊息，連線已重置，正在重新連線。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンピュータがメッセージを拒否しました。接続をリセットし、再接続しています。"
          }
        }
      }
    },
    "The conversation will be deleted from the computer. This cannot be undone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The conversation will be deleted from the computer. This cannot be undone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对话会从电脑上删除，无法恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對話將從電腦上刪除，此動作無法復原。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会話をコンピュータから削除します。この操作は取り消せません。"
          }
        }
      }
    },
    "The image is still larger than 512 KiB after compression.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The image is still larger than 512 KiB after compression."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片太大，压缩后仍超过 512 KiB。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖片壓縮後仍超過 512 KiB。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "圧縮後も画像が 512 KiB を超えています。"
          }
        }
      }
    },
    "The model is chosen when the conversation is created and cannot be changed later.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model is chosen when the conversation is created and cannot be changed later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型只能在新建时选择，之后不能更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "模型只能在新增對話時選擇，之後無法更改。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルは会話の作成時に選択し、後から変更することはできません。"
          }
        }
      }
    },
    "The model list is being read; try again shortly, or type a model name.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model list is being read; try again shortly, or type a model name."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在读取模型列表，稍后再试；也可以直接输入模型名。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在讀取模型列表，請稍後再試，或直接輸入模型名稱。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルの一覧を読み込み中です。しばらくしてからもう一度試すか、モデル名を入力してください。"
          }
        }
      }
    },
    "The other side could not prove it is the paired computer, so the connection was closed. Check the address.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The other side could not prove it is the paired computer, so the connection was closed. Check the address."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方无法证明自己是已配对的电脑，已断开。请检查地址是否正确。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對方無法證明自己是已配對的電腦，連線已中斷。請檢查位址是否正確。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続先がペアリング済みのコンピュータであることを確認できなかったため、接続を切断しました。アドレスを確認してください。"
          }
        }
      }
    },
    "The pairing link is incomplete or damaged.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The pairing link is incomplete or damaged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对链接不完整或已损坏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "配對連結不完整或已損毀。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリングリンクが不完全か、破損しています。"
          }
        }
      }
    },
    "The phone deletes its key. To revoke it completely, run chrome-use mobile revoke on the computer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The phone deletes its key. To revoke it completely, run chrome-use mobile revoke on the computer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手机会删除它的密钥。要彻底撤销，请在电脑上运行 chrome-use mobile revoke。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手機會刪除它的金鑰。若要完全撤銷，請在電腦上執行 chrome-use mobile revoke。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone の鍵が削除されます。完全に取り消すには、コンピュータで chrome-use mobile revoke を実行してください。"
          }
        }
      }
    },
    "The previous computer will be removed from this phone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The previous computer will be removed from this phone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原来的电脑会从这部手机上删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原本的電腦會從這支手機上移除。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前のコンピュータはこの iPhone から削除されます。"
          }
        }
      }
    },
    "The purchase could not be verified: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The purchase could not be verified: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
