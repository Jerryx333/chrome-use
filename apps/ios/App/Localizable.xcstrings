    "Your trial has ended. Reading, stopping and declining stay free; sending, starting conversations and allowing requests need the unlock.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your trial has ended. Reading, stopping and declining stay free; sending, starting conversations and allowing requests need the unlock."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "试用已结束。查看对话、停止任务和拒绝请求仍然免费；发送、新建和允许请求需要解锁。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "試用已結束。檢視對話、停止任務和拒絕請求仍然免費；傳送訊息、新增對話和允許請求則需要解鎖。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トライアルが終了しました。閲覧、停止、拒否は引き続き無料です。送信、会話の開始、リクエストの許可にはロック解除が必要です。"
          }
        }
      }
    },
    "chrome-use %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "chrome-use %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "chrome-use %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "chrome-use %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "chrome-use %@"
          }
        }
      }
    },
    "chrome-use Remote drives the agent panel on your computer from your phone; the agent and your signed-in Chrome stay on the computer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "chrome-use Remote drives the agent panel on your computer from your phone; the agent and your signed-in Chrome stay on the computer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "chrome-use 遥控让你在手机上操作电脑上的 agent 面板；agent 和登录的 Chrome 都留在电脑上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "chrome-use Remote 讓你用手機操作電腦上的 agent 面板；agent 和已登入的 Chrome 都留在電腦上。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "chrome-use Remote を使うと、コンピュータのエージェントパネルを iPhone から操作できます。エージェントとサインイン済みの Chrome はコンピュータ上で動作し続けます。"
          }
        }
      }
    },
    "chrome-use is locked": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "chrome-use is locked"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "chrome-use 已锁定"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "chrome-use 已鎖定"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "chrome-use はロックされています"
          }
        }
      }
    },
