    "Pairing creates a key that exists only on this phone; the QR code stops working right away and cannot be scanned again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairing creates a key that exists only on this phone; the QR code stops working right away and cannot be scanned again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对会生成一份只存在这部手机里的密钥；二维码随即失效，再扫一次也无法使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "配對會產生一組只存在這支手機上的金鑰；QR 碼會立即失效，無法再次掃描使用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリングすると、この iPhone にのみ存在する鍵が作成されます。QR コードはすぐに無効になり、再度スキャンしても使用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페어링하면 이 휴대폰에만 있는 키가 생성됩니다. QR 코드는 즉시 무효화되며 다시 스캔할 수 없습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al emparejar se crea una clave que solo existe en este teléfono; el código QR deja de funcionar al instante y no se puede volver a escanear."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jumelage crée une clé qui n’existe que sur ce téléphone ; le code QR cesse aussitôt de fonctionner et ne peut pas être scanné à nouveau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Koppeln wird ein Schlüssel erzeugt, der nur auf diesem iPhone existiert; der QR-Code wird sofort ungültig und kann nicht erneut gescannt werden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O emparelhamento cria uma chave que existe apenas neste iPhone; o código QR deixa de funcionar na hora e não pode ser escaneado de novo."
          }
        }
      }
    },
