    "Pairing creates a key that exists only on this phone; the QR code stops working right away and cannot be scanned again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairing creates a key that exists only on this phone; the QR code stops working right away and cannot be scanned again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对会生成一份只存在这部手机里的密钥；二维码随即失效，再扫一次也无法使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "配對會產生一組只存在這支手機上的金鑰；QR 碼會立即失效，無法再次掃描使用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリングすると、この iPhone にのみ存在する鍵が作成されます。QR コードはすぐに無効になり、再度スキャンしても使用できません。"
          }
        }
