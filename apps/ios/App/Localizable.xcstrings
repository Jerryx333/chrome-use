    "Stop was requested: you can only decline now.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop was requested: you can only decline now."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已请求停止：只能拒绝，不能再允许。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已要求停止：現在只能拒絕。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "停止がリクエストされたため、拒否のみ選択できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중단이 요청되었습니다. 이제 거부만 할 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pidió detener: ahora solo puedes denegar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un arrêt a été demandé : vous pouvez seulement refuser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopp wurde angefordert: Du kannst jetzt nur noch ablehnen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A parada foi solicitada: agora você só pode recusar."
          }
        }
      }
    },
